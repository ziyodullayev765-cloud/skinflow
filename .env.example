# --- Server only. NEVER expose these to the frontend. ---
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skinflow
# Set to "true" for hosted Postgres that requires TLS (Neon, Supabase…)
DATABASE_SSL=false

# Telegram bot token from @BotFather — used ONLY to verify initData signatures
TELEGRAM_BOT_TOKEN=

# Separate admin bot (opens /admin as a Mini App) and the Telegram user IDs allowed in
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Vercel Blob image storage — set automatically when a Blob store is connected to the project.
# Current Vercel stores use BLOB_STORE_ID (+ OIDC, no secret needed); older ones use BLOB_READ_WRITE_TOKEN.
# Without either (local dev) images are written to ./uploads and served at /api/files/*
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional canonical public URL (used for bot buttons / webhooks)
PUBLIC_URL=

# Long random string (>= 32 chars) used to sign user session tokens
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First admin account, created on first boot if no admins exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Allow browser visitors outside Telegram to get a server-created guest account
ALLOW_GUEST_LOGIN=true

# Max age of Telegram initData in seconds (default 24h)
TELEGRAM_AUTH_MAX_AGE=86400
